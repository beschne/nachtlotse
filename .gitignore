# macOS Finder metadata
.DS_Store

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Skyfield ephemeris cache, Open-Meteo forecast cache — both
# re-downloadable, neither committed.
.cache/

# Your local observing-site and rig lists — never committed. Copy the
# matching *.template.yaml to create them; see nachtlotse/data/store.py.
# (unanchored, so it matches regardless of how deep the project root sits)
sites_local.yaml
rigs_local.yaml

# Your local --prose config (Anthropic API key, chosen model) — a real
# secret, never committed. Copy prose_local.template.yaml to create it;
# entirely optional, see nachtlotse/data/store.py.
prose_local.yaml

# Local secrets — never committed.
secrets/
scratch.md/

# `lotse plan --chart`'s default PNG output — generated on demand into
# whatever directory you run it from, never a build artifact to commit.
nachtlotse-shortlist.png

# Throwaway PyObjC-vs-PySide6 framework spike (ROADMAP.md's native macOS
# app item) — deliberately not committed: this project doesn't maintain
# two front ends even mid-decision (see the Streamlit MVP's retirement in
# STATUS.md). The decision is made (PySide6 won); kept locally only as a
# reference for how it was reached (see macos-app-spike/README.md), not
# because it's still needed — the real app lives in nachtlotse/gui/.
macos-app-spike/
